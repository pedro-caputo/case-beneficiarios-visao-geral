# Auto detect text files and perform LF normalization
* text=auto

# Arquivos de documentação e código
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.mmd text eol=lf
*.txt text eol=lf

# Binários e imagens
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
